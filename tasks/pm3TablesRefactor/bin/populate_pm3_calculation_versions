const verifyAllVersionsHaveTmcMetadata = calculationVersions =>
  Object.keys(calculationVersions).forEach(year =>
    Object.keys(calculationVersions[year]).forEach(measureClass =>
      Object.keys(calculationVersions[year][measureClass]).forEach(
        dataProvenanceWindow => {
          const includedRunsMeta =
            calculationVersions[year][measureClass][dataProvenanceWindow];

          _(includedRunsMeta)
            .map('state')
            .uniq()
            .value()
            .forEach(state => {
              const numRunsIncludingTmcMetadata = includedRunsMeta
                .filter(({ state: s }) => s === state)
                .reduce(
                  (acc, { includesTmcMetadata }) => acc + +includesTmcMetadata,
                  0
                );

              if (numRunsIncludingTmcMetadata !== 1) {
                console.error(
                  year,
                  state,
                  measureClass,
                  'has',
                  numRunsIncludingTmcMetadata,
                  'TMC_METADATA'
                );
              }
            });
        }
      )
    )
  );

const injectOtherStatesIntoCalculationVersions = (mergedMeta, nyVersioned) => {
  const versionedCalculations = _.cloneDeep(nyVersioned);

  Object.keys(mergedMeta).forEach(year =>
    Object.keys(mergedMeta[year])
      .filter(state => state !== 'ny')
      .forEach(state => {
        Object.keys(mergedMeta[year][state]).forEach(measureClass => {
          const runMetas = mergedMeta[year][state][measureClass].filter(
            ({ measure }) => measure !== 'SPEED_PERCENTILES'
          );

          runMetas
            .filter(
              ({ measures }) => !_.isEqual(measures, ['SPEED_PERCENTILES'])
            )
            .forEach(runMeta => {
              const version = _.findLast(
                versionedCalculations[year][measureClass],
                verMeta =>
                  verMeta
                    .filter(({ state: s }) => s === 'ny')
                    .some(
                      ({ calculator_run_timestamp: ts }) =>
                        ts.slice(0, 7) <=
                        runMeta.calculator_run_timestamp.slice(0, 7)
                    )
              );

              if (version) {
                version.push(runMeta);
              }
            });

          // console.log(JSON.stringify(d, null, 4));
        });
      })
  );

  return versionedCalculations;
};

const loadCalcVersions = async (client, versionedCalculations) => {
  const rows = [];
  Object.keys(versionedCalculations).forEach(year =>
    Object.keys(versionedCalculations[year]).forEach(measureClass =>
      Object.keys(versionedCalculations[year][measureClass])
        .map(dataProvenanceWindow => +dataProvenanceWindow)
        .sort((a, b) => a - b)
        .forEach((dataProvenanceWindow, i) => {
          const d =
            versionedCalculations[year][measureClass][dataProvenanceWindow];

          const { calculator_run_timestamp } = _.first(
            d.filter(({ state }) => state === 'ny')
          );

          const pm3calc_ids = d
            .map(({ calcRunId }) => +calcRunId)
            .sort((a, b) => +a - +b);

          const isPreRelease = +year === +calculator_run_timestamp.slice(0, 4);

          const prevRow = _.last(rows);

          const fix_version = isPreRelease
            ? 0
            : +(!!prevRow && prevRow.year === year && prevRow.fix_version) + 1;

          const prerelease_label = isPreRelease
            ? `partial_year_${_.padStart(i + 1, 2, '0')}`
            : null;

          rows.push({
            year: +year,
            measure_class: measureClass,
            major_version: MAJOR_VERSION,
            minor_version: calculator_run_timestamp < '2020' ? 1 : 2,
            fix_version,
            prerelease_label,
            pm3calc_ids
          });
        })
    )
  );

  const sql = `
    INSERT INTO pm3.pm3_calculation_versions (
        year,
        measure_class,
        major_version,
        minor_version,
        fix_version,
        prerelease_label,
        pm3calc_ids
      )
      VALUES($1, $2, $3, $4, $5, $6, $7)
    ;`;

  for (let i = 0; i < rows.length; ++i) {
    try {
      await client.query(sql, [
        rows[i].year,
        rows[i].measure_class,
        rows[i].major_version,
        rows[i].minor_version,
        rows[i].fix_version,
        rows[i].prerelease_label,
        rows[i].pm3calc_ids
      ]);
    } catch (err) {
      console.warn(err);
    }
  }
};

(async () => {
  try {
    const client = new Client();
    await client.connect();

    try {
      const calcRunsMetadata = await getCalcRunMetadata(client);
      const calcDataProvenances = await getCalcDataProvenances(client);

      const dataProvenanceWindows = getDataProvenanceWindows(
        calcRunsMetadata,
        calcDataProvenances
      );

      const mergedMeta = mergeRunMetadataWithDataProvenances(
        calcRunsMetadata,
        calcDataProvenances,
        dataProvenanceWindows
      );

      const nyVersioned = groupNYCalcsIntoVersions(mergedMeta);

      const calculationVersions = injectOtherStatesIntoCalculationVersions(
        mergedMeta,
        nyVersioned
      );

      verifyAllVersionsHaveTmcMetadata(calculationVersions);
      await loadCalcVersions(client, calculationVersions);

      // console.log(JSON.stringify(tmcMetadataRuns, null, 4));
      // console.log(JSON.stringify(mergedMeta, null, 4));
    } catch (err) {
      console.error(err);
    } finally {
      client.end();
    }
  } catch (err) {
    console.error(err);
    process.exit(1);
  }
})();
