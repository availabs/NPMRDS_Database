#!/usr/bin/env node

/* eslint no-console: 0, no-await-in-loop: 0, no-param-reassign: 0 */

const assert = require('assert');
const { join } = require('path');

const _ = require('lodash');
// const through2 = require('through2');

const { Client } = require('pg');

const yargs = require('yargs');
const envFile = require('node-env-file');

const cliArgsSpec = {
  pg_env: {
    type: 'string',
    demand: false,
    choices: ['production', 'development'],
    default: 'development'
  }
};

const { argv } = yargs
  .strict()
  .parserConfiguration({
    'camel-case-expansion': false,
    'flatten-duplicate-arrays': false
  })
  .wrap(yargs.terminalWidth() / 1.618)
  .option(cliArgsSpec);

const { pg_env } = argv;

const configPath = join(
  __dirname,
  pg_env === 'production'
    ? '../../../config/postgres.env.prod'
    : '../../../config/postgres.env.dev'
);
envFile(configPath);

const MAJOR_VERSION = 1;

const getCalcRunMetadata = async client => {
  const sql = `
    SELECT
        id,
        (metadata - 'dbState') AS metadata
      FROM pm3.pm3_calculator_metadata
    ;
  `;
  const { rows } = await client.query(sql);

  return rows.reduce((acc, { id, metadata }) => {
    acc[id] = metadata;
    return acc;
  }, {});
};

const getCalcDataProvenances = async client => {
  const sql = `
    SELECT
        id,
        data_provenance_metadata
      FROM pm3.pm3_calculator_data_provenances
    ;
  `;
  const { rows } = await client.query(sql);

  const indexedDataProvenances = rows.reduce(
    (acc, { id, data_provenance_metadata }) => {
      acc[id] = data_provenance_metadata;
      return acc;
    },
    {}
  );

  return indexedDataProvenances;
};

const measureClassifier = ({ measure, isCanonical }) => {
  if (/^RIS_|_RIS$/.test(measure)) {
    return 'RIS';
  }

  return isCanonical && /^LOTTR$|^TTTR$|^PHED$/.test(measure) ? 'FHWA' : 'AUX';
};

const getDataProvenanceWindows = (calcRunsMetadata, calcDataProvenances) => {
  const dataProvs = Object.keys(calcDataProvenances).reduce(
    (acc, calcRunId) => {
      const {
        calculatorSettings: { year }
      } = calcRunsMetadata[calcRunId];

      acc[year] = acc[year] || {};

      const states = Object.keys(calcDataProvenances[calcRunId]);

      for (let j = 0; j < states.length; ++j) {
        const state = states[j];
        acc[year][state] = acc[year][state] || [];

        acc[year][state].push(
          _.omit(
            calcDataProvenances[calcRunId][state],
            'calculator_run_timestamp'
          )
        );
      }
      return acc;
    },
    {}
  );

  Object.keys(dataProvs).forEach(year => {
    Object.keys(dataProvs[year]).forEach(state => {
      dataProvs[year][state] = _(dataProvs[year][state])
        .uniqWith(_.isEqual)
        .sortBy([
          'npmrds_data_version_download_timestamp',
          'tmc_metadata_version_timestamp'
          // 'pm3_calculator_code_version_timestamp'
        ])
        .values();
    });
  });

  return dataProvs;
};

const mergeRunMetadataWithDataProvenances = (
  calcRunsMetadata,
  calcDataProvenances,
  dataProvenanceWindows
) => {
  const mergedMeta = Object.keys(calcRunsMetadata).reduce((acc, calcRunId) => {
    const {
      calculators,
      gitRepoState: { hash: gitHash },
      calculatorSettings: {
        year,
        states,
        outputHPMSRequiredTmcMetadata: includesTmcMetadata
      }
    } = calcRunsMetadata[calcRunId];

    for (let i = 0; i < states.length; ++i) {
      const state = states[i];

      const measuresByClass = calculators.reduce((acc2, calcMeta) => {
        const measureClass = measureClassifier(calcMeta);
        acc2[measureClass] = _.uniq(
          Array.prototype.concat(acc2[measureClass] || [], calcMeta.measure)
        ).sort();
        return acc2;
      }, {});

      const measureClasses = Object.keys(measuresByClass);

      const dataProvenance = calcDataProvenances[calcRunId][state];

      acc[year] = acc[year] || {};
      acc[year][state] = acc[year][state] || {};

      for (let j = 0; j < measureClasses.length; ++j) {
        const measureClass = measureClasses[j];
        acc[year][state][measureClass] = acc[year][state][measureClass] || [];

        const dataProvenanceWindow = dataProvenanceWindows[year][
          state
        ].findIndex(dataProvWindowMeta =>
          _.isEqual(
            dataProvWindowMeta,
            _.pick(dataProvenance, Object.keys(dataProvWindowMeta))
          )
        );

        acc[year][state][measureClass].push({
          calcRunId,
          state,
          includesTmcMetadata,
          year,
          gitHash,
          measures: measuresByClass[measureClass],
          dataProvenanceWindow,
          ...dataProvenance
        });
      }
    }

    return acc;
  }, {});

  Object.keys(mergedMeta).forEach(year =>
    Object.keys(mergedMeta[year]).forEach(state =>
      Object.keys(mergedMeta[year][state]).forEach(measureClass => {
        mergedMeta[year][state][measureClass] = _(
          mergedMeta[year][state][measureClass]
        )
          .uniq()
          .sortBy('dataProvenanceWindow')
          .value();
      })
    )
  );

  return mergedMeta;
};

const groupNYCalcsIntoVersions = mergedMeta => {
  const nyCalcVersioned = Object.keys(mergedMeta).reduce((acc, year) => {
    acc[year] = {};

    const nyMeta = mergedMeta[year].ny;

    Object.keys(nyMeta).forEach(measureClass => {
      acc[year][measureClass] = {};

      const runMetas = nyMeta[measureClass];

      runMetas.forEach(runMeta => {
        if (_.isEqual(runMeta.measures, ['SPEED_PERCENTILES'])) {
          return;
        }

        // Initial RIS_ measure runs had RIS as a measure name prefix.
        //   This was changed so _RIS is the suffix.
        if (
          measureClass === 'RIS' &&
          runMeta.measures.some(measure => /^RIS_/.test(measure))
        ) {
          return;
        }

        const { dataProvenanceWindow } = runMeta;

        acc[year][measureClass][dataProvenanceWindow] =
          acc[year][measureClass][dataProvenanceWindow] || [];

        acc[year][measureClass][dataProvenanceWindow].push(runMeta);

        // TODO: Verify that the omitted calculations are in fact
        //       equivalent with their "equal"
        acc[year][measureClass][dataProvenanceWindow] = _.uniqWith(
          acc[year][measureClass][dataProvenanceWindow],
          (a, b) =>
            _.isEqual(
              _.omit(a, ['calcRunId', 'calculator_run_timestamp']),
              _.omit(b, ['calcRunId', 'calculator_run_timestamp'])
            )
        );
      });
    });

    return acc;
  }, {});

  Object.keys(nyCalcVersioned).forEach(year =>
    Object.keys(nyCalcVersioned[year]).forEach(measureClass =>
      Object.keys(nyCalcVersioned[year][measureClass]).forEach(
        dataProvenanceWindow => {
          const measures = _.flattenDeep(
            _.map(
              nyCalcVersioned[year][measureClass][dataProvenanceWindow],
              'measures'
            )
          );

          assert(measures.length === _.uniq(measures).length);
        }
      )
    )
  );

  return nyCalcVersioned;
};

