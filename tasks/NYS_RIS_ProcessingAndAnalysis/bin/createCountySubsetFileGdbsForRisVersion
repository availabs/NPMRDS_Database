#!/bin/bash

# NOTE: Temporarily punting on a higher level of automation due to source base_data schema inconsistencies.
#   Handing the changing file and layer names will require more sophisticated code.
#     It would probably be best to write that code in a language other than Bash.
#     Therefore, it would probably best to extract the variables below using code on the host machine
#       and set in the container using ENV variables.

set -e

if [ -z "$GDB_TIMESTAMP" ] || [ -z "$GDB_NAME" ] || [ -z "$COUNTY_NAME" ]; then
  >&2 echo "USAGE: The GDB_TIMESTAMP, GDB_NAME and COUNTY_NAME environment variables are required"
  exit 1
fi

# NOTE: These should remain standardized for future storage and tool building.
GDB_PATH="/base_data/$GDB_NAME"

OUTPUT_LAYER_NAME="roadway_inventory_system"
COUNTY_GDB_NAME="${OUTPUT_LAYER_NAME}.${GDB_TIMESTAMP}.${COUNTY_NAME,,}.gdb"
COUNTY_GDB_PATH="/derived_data/$COUNTY_GDB_NAME"

pushd  "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null

mkdir -p derived_data/

docker \
  run \
  --env GDB_PATH="$GDB_PATH" \
  --env COUNTY_NAME="$COUNTY_NAME" \
  --env COUNTY_GDB_PATH="$COUNTY_GDB_PATH" \
  --env OUTPUT_LAYER_NAME="$OUTPUT_LAYER_NAME" \
  --rm \
  -v "$PWD/scripts":"/scripts/" \
  -v "$PWD/base_data/nys_ris_v$GDB_TIMESTAMP":"/base_data/" \
  -v "$PWD/derived_data/":"/derived_data/" \
  gdal-with-filegdb:latest /scripts/createCountySubsetFileGdb

popd >/dev/null
