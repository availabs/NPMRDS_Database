#!/bin/bash

set -e

if [ -z "$1" ] || [ -z "$2" ] ; then
  >&2 echo "USAGE: The RIS_VERSION_A and RIS_VERSION_B must be provided as the 1st and 2nd positional variables"
  exit 1
fi

RIS_VERSION_A="$1"
RIS_VERSION_B="$2"

VERSION_A_GPKG_PATH="derived_data/roadway_inventory_system.$RIS_VERSION_A.gpkg"
VERSION_B_GPKG_PATH="derived_data/roadway_inventory_system.$RIS_VERSION_B.gpkg"

COMM_FILE_BASE="derived_data/ris_version_comparison.v$RIS_VERSION_A-v$RIS_VERSION_B"
COMM_DB_PATH="$COMM_FILE_BASE.sqlite3"
COMM_GPKG_PATH="$COMM_FILE_BASE.gpkg"

pushd  "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null

rm -f "$COMM_DB_PATH"

# NOTE: last statement cannot use the -cmd flag
sqlite3 "$COMM_DB_PATH" \
  -cmd "ATTACH '$VERSION_A_GPKG_PATH' AS ris_a; ATTACH '$VERSION_B_GPKG_PATH' AS ris_b;" \
  -cmd '.read sql/create_versions_table.sql' \
  -cmd '.read sql/create_segment_version_inclusion_table.sql' \
  -cmd '.read sql/create_changed_geometries.sql' \
  '.read sql/create_aadt_years_summary.sql' \

docker \
  run \
  --env VERSION_A_GPKG_PATH="/$VERSION_A_GPKG_PATH" \
  --env VERSION_B_GPKG_PATH="/$VERSION_B_GPKG_PATH" \
  --env COMM_DB_PATH="/$COMM_DB_PATH" \
  --env COMM_GPKG_PATH="/$COMM_GPKG_PATH" \
  --rm \
  -v "$PWD/sql":"/sql/" \
  -v "$PWD/scripts":"/scripts/" \
  -v "$PWD/derived_data/":"/derived_data/" \
  gdal-with-filegdb:latest /scripts/createComparisonGeoPackage


# Copy the comparison database tables into the comparison GeoPackage,
#   then delete the comparison database.
sqlite3 "$COMM_DB_PATH" '.dump' | sqlite3 "$COMM_GPKG_PATH"

rm -f "$COMM_DB_PATH"


popd >/dev/null
