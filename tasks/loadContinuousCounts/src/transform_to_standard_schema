const dowMapper = {
  Sunday: 1,
  Monday: 2,
  Tuesday: 3,
  Wednesday: 4,
  Thursday: 5,
  Friday: 6,
  Saturday: 7
};

const classFValMappper = v => (Number.isFinite(+v) ? +v : null);

const columnValueMappings = {
  Day_of_week: v => dowMapper[v],
  Year: _.parseInt,
  Month: _.parseInt,
  Day: _.parseInt,
  Federal_Direction: _.parseInt,
  Class_F1: classFValMappper,
  Class_F2: classFValMappper,
  Class_F3: classFValMappper,
  Class_F4: classFValMappper,
  Class_F5: classFValMappper,
  Class_F6: classFValMappper,
  Class_F7: classFValMappper,
  Class_F8: classFValMappper,
  Class_F9: classFValMappper,
  Class_F10: classFValMappper,
  Class_F11: classFValMappper,
  Class_F12: classFValMappper,
  Class_F13: classFValMappper
};

const dbColumns = [
  'rc',
  'station',
  'region',
  'dotid',
  'ccid',
  'fc',
  'route',
  'roadname',
  'county',
