#!/usr/bin/env node

const { execSync } = require("child_process");
const { join } = require("path");

const loaderGenerator = join(__dirname, "./generateFreightAtlasLoader");

const NysdotFreightAtlas2016LayerNames = require("../metadata/NysdotFreightAtlas2016LayerNames.json");

function generateAllFreightAtlasLoaders(
  layerNames = Object.keys(NysdotFreightAtlas2016LayerNames)
) {
  for (const layerName of layerNames) {
    try {
      const stdout = execSync(`${loaderGenerator} ${layerName}`, {
        encoding: "utf8",
      });

      if (stdout) {
        console.log(stdout);
      }
    } catch (err) {
      // Above execSync call already writes error messages to STDERR
    }
  }
}

if (require.main === module) {
  generateAllFreightAtlasLoaders();
}

module.exports = generateAllFreightAtlasLoaders;
