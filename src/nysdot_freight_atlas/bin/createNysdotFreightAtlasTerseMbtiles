#!/usr/bin/env node

const { execSync } = require("child_process");
const { mkdirSync, renameSync } = require("fs");
const { join } = require("path");

const _ = require("lodash");

const tmp = require("tmp");

const { Client } = require("pg");

const dotenv = require("dotenv");

const {
  getPostgresConfigurationFilePath,
} = require("../../../make_targets/utils");

let db = null;

const table_version = "2016";
const pg_env = process.env.PG_ENV || "development";

const timestamp = new Date().toISOString().replace(/[^0-9A-Za-z]/g, "");

const outputDir = join(__dirname, "../mbtiles");
const outputFilePath = join(
  outputDir,
  `nysdot_freight_atlas.${table_version}.${timestamp}.mbtiles`
);

const putPostgresCredentialsInEnvironmentVariables = _.once(() => {
  const configPath = getPostgresConfigurationFilePath(pg_env);

  dotenv.config({ path: configPath });

  const { PGDATABASE, PGHOST, PGPORT } = process.env;

  console.error(
    `Using ${PGDATABASE} at ${PGHOST}:${PGPORT} for the most recent Transcom event timestamp.`
  );
});

tmp.setGracefulCleanup();
const { name: tmpDirPath, removeCallback: removeTmpDir } = tmp.dirSync({
  keep: false,
  unsafeCleanup: true,
  // keep: true,
  // unsafeCleanup: false,
});

/*
  NOTE: I cannot get this to work. Punting for now.

process.on("exit", () => {
  console.log("exit event");
  try {
    rmdirSync(tmpDirPath, { recursive: true });
  } catch (err) {}
});
*/

async function connectClient() {
  putPostgresCredentialsInEnvironmentVariables();
  db = new Client();
  return await db.connect();
}

async function disconnectClient() {
  return await db.end();
}

async function getNysdotFreightAtlasTablesForVersion() {
  const { rows } = await db.query(`
    SELECT DISTINCT
        tablename
      FROM pg_catalog.pg_tables
      WHERE (
        ( schemaname = 'nysdot_freight_atlas' )
        AND
        ( tablename ~ '_v${table_version}$' )
      )
      ORDER BY tablename
  `);

  const tables = rows.map(({ tablename }) => tablename);

  return tables;
}

function dumpNysdotFreightAtlasTable(table) {
  putPostgresCredentialsInEnvironmentVariables();

  const { PGHOST, PGUSER, PGDATABASE, PGPASSWORD } = process.env;

  const creds = `host='${PGHOST}' user='${PGUSER}' dbname='${PGDATABASE}' password='${PGPASSWORD}'`;

  console.log("dumping", table, "to GeoJSON");

  // NOTE: The process hung when using ${geojson_to_ndjson}
  const cmd = `
    ogr2ogr \
      -f 'GeoJSON' \
      /vsistdout/ \
      -skipfailures \
      PG:"${creds}" \
      -sql 'SELECT objectid AS id, wkb_geometry FROM nysdot_freight_atlas.${table}' \
    | gzip -9 \
    > ${table}.geojson.gz
  `;

  const stdout = execSync(cmd, { cwd: tmpDirPath, encoding: "utf8" });
  if (stdout) {
    console.log("\n=== ogr2ogr output ===");
    console.log(stdout);
  }
}

function dumpNysdotFreightAtlasTables(tables) {
  for (const table of tables) {
    dumpNysdotFreightAtlasTable(table);
  }
}

function createMbtilesLayer(tables) {
  const geojsonFileNames = tables.map((t) => `${t}.geojson.gz`).join(" ");
  const tmpMbfilesName = `nysdot_freight_atlas.${table_version}.terse.mbtiles`;

  // NOTE:  The --read-parallel option requires geojsonl
  //        See https://github.com/mapbox/tippecanoe/issues/191
  const cmd = `
    tippecanoe \
      --no-feature-limit \
      --no-tile-size-limit \
      --generate-ids \
      --force \
      -o ${tmpMbfilesName} \
      ${geojsonFileNames}
  `;

  execSync(cmd, {
    cwd: tmpDirPath,
    encoding: "utf8",
    stdio: "inherit",
  });

  const tmpMbfilesPath = join(tmpDirPath, tmpMbfilesName);

  return tmpMbfilesPath;
}

function moveOutputToMbtilesDir(tmpMbfilesPath) {
  mkdirSync(outputDir, { recursive: true });
  renameSync(tmpMbfilesPath, outputFilePath);

  return outputFilePath;
}

async function createNysdotFreightAtlasMbtiles() {
  try {
    console.log(tmpDirPath);

    await connectClient();
    const tables = await getNysdotFreightAtlasTablesForVersion();

    dumpNysdotFreightAtlasTables(tables);

    const tmpMbfilesPath = createMbtilesLayer(tables);
    moveOutputToMbtilesDir(tmpMbfilesPath);
  } catch (err) {
    console.error(err);
  } finally {
    disconnectClient();
    removeTmpDir();
  }
}

if (require.main === module) {
  createNysdotFreightAtlasMbtiles();
}

module.exports = createNysdotFreightAtlasMbtiles;
