#!/usr/bin/env node

const { join, isAbsolute } = require('path');
const { execSync } = require('child_process');
const { existsSync, readdirSync } = require('fs');
const { fileSync: tmpFileSync } = require('tmp');

const { pick, padStart } = require('lodash');

const yargs = require('yargs');
const { sync: mkdirpSync } = require('mkdirp');

const YEARS = require('./YEARS');
const REGIONS = require('./REGIONS');
const TABLES = require('./TABLES');

const yargsSpec = {
  years: {
    alias: 'year',
    type: 'array',
    demand: false,
    default: YEARS
  },
  regions: {
    alias: 'region',
    type: 'array',
    demand: false,
    default: REGIONS
  },
  tables: {
    alias: 'table',
    type: 'array',
    demand: false,
    default: TABLES
  },
  downloadDir: {
    type: 'string',
    demand: true
  }
};

const {
  argv: { years, regions, tables, downloadDir }
} = yargs
  .strict()
  .parserConfiguration({
    'camel-case-expansion': false,
    'flatten-duplicate-arrays': true
  })
  .wrap(yargs.terminalWidth() / 1.618)
  .option(yargsSpec);

const downloadDirAbsPath = isAbsolute(downloadDir)
  ? downloadDir
  : join(process.cwd(), downloadDir);

mkdirpSync(downloadDirAbsPath);

const regionTemplateRegExp = /==REGION==/;

const urlBase = 'https://www.dot.ny.gov/divisions/engineering';

years.forEach(year => {
  // https://www.dot.ny.gov/divisions/engineering/technical-services/highway-data-services/hdsb
  const csvURLBase = `${urlBase}/technical-services/highway-data-services/hdsb/repository`;

  const csvURLs = {
    average_weekday_speed: `SC_Speed_AVGWD_==REGION==_${year}.zip`,
    average_weekday_vehicle_classification: `SC_CLASS_AVGWD_==REGION==_${year}.zip`,
    average_weekday_volume: `SC_Volume_AVGWD_==REGION==_${year}.zip`,
    continuous_vehicle_classification: `CC_CLASS_==REGION==_${year}.zip`,
    continuous_volume: `CC_VOL_==REGION==_${year}.zip`,
    short_count_speed: `SC_Speed_Data_==REGION==_${year}.zip`,
    short_count_vehicle_classification: `SC_Class_Data_==REGION==_${year}.zip`,
    short_count_volume: `SC_Volume_Data_==REGION==_${year}.zip`
  };

  const requestedURLs = pick(csvURLs, tables);

  for (let i = 0; i < regions.length; i += 1) {
    Object.entries(requestedURLs).forEach(([tableName, basenameTemplate]) => {
      // The continuous count region numbers are not zero padded. The others are.
      const region = basenameTemplate.match(/^CC_/)
        ? +regions[i]
        : padStart(regions[i], 2, '0');

      const dir = join(
        downloadDirAbsPath,
        `${tableName}`,
        `${year}`,
        `R${padStart(regions[i], 2, '0')}`
      );

      mkdirpSync(dir);

      const basename = basenameTemplate.replace(
        regionTemplateRegExp,
        `R${region}`
      );

      const url = `${csvURLBase}/${basename}`;
      const zipFilePath = join(dir, basename);

      if (existsSync(zipFilePath)) {
        console.log(zipFilePath);
        console.log(`${basename} already downloaded. Skipping...`);
      } else {
        console.log(`Downloading ${basename}`);

        try {
          console.log(url);
          execSync(`curl -k -o '${zipFilePath}' '${url}'`);

          execSync(`unzip -o ${zipFilePath}`, { cwd: dir });
          execSync(`rm -f ${zipFilePath}`, { cwd: dir });

          // Get the name of the extracted CSV.
          const csvFileName = readdirSync(dir).filter(f => f.match(/csv$/i))[0];

          const sedProgram =
            // Trim whitespace from the columns.
            's/ *, */,/g; ' +
            // Remove Windows line endings.
            's/\r//; ' +
            // Fix the columns here either side of an '/' are many whitespaces apart.
            's# */ *# / #g; ' +
            // Delete the "row selected" lines from the CSV
            '/rows selected/d; ' +
            // Some CSVs had a line with ---,---,
            //   So we delete rows that have no alpha-numeric characters
            '/[A-Za-Z0-9]/!d';

          execSync(`sed -i '${sedProgram}' '${csvFileName}'`, {
            cwd: dir
          });

          // Remove duplicate rows to fix the problem of the header showing up at the beginning and the end of a file.
          // https://stackoverflow.com/a/20639730/3970755
          // Put the cleaned output into a temporary file
          const { name: tmpFileName } = tmpFileSync();
          execSync(
            `cat -n '${csvFileName}' | sort -uk2 | sort -nk1 | cut -f2- > ${tmpFileName}`,
            { cwd: dir }
          );

          // Rename the cleaned file back to the name of the original CSV
          execSync(`mv ${tmpFileName} '${csvFileName}'`, {
            cwd: dir
          });

          // Compress the CSV
          execSync(`gzip -9 '${csvFileName}'`, { cwd: dir });
        } catch (err) {
          // If we encountered an error, remove the directory in which the ETL error occurred.
          execSync(`rm -rf ${dir}`);
        }
      }
    });
  }
});

try {
  // recursively remove empty directories
  execSync(`
    find ${downloadDirAbsPath} -type d |
      awk '{ print length(), $0 | "sort -n -r" }' |
      cut -d' ' -f2- |
      while read d; do
        rmdir "$d" 2>/dev/null;
      done;
  `);
} catch (err) {
  // ignore error
}
